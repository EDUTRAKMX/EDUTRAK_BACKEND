# Copy to .env and adjust. All values below are FICTITIOUS placeholders.

APP_ENV=development
LOG_LEVEL=info
HTTP_PORT=8080

# Required
DATABASE_URL=postgres://edutrak:edutrak_dev_password@localhost:5432/edutrak?sslmode=disable
# Required, at least 32 bytes. Generate your own, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me

# Browser origins allowed to call the API cross-origin (comma-separated, exact scheme://host[:port],
# no path, NEVER "*"). Empty = no CORS headers (same-origin only). Production requires https origins.
# Example for a Vite dev server: CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
QR_TOKEN_TTL=30s

# Networks allowed to register attendance by QR (comma-separated CIDRs/IPs).
# Use the REAL public egress address(es) of the institution (many students usually share one
# because of NAT) -- ask the network team. 192.0.2.0/24 below is a documentation-only
# placeholder, NOT an institutional range. Private ranges (10.x, 192.168.x) are not evidence
# of presence by themselves: list them only if they are really what the backend sees.
# Empty = no QR check-in is accepted. APP_ENV=production refuses to start without it (or with /0).
# ALLOWED_NETWORKS=192.0.2.0/24
# Reverse proxies whose X-Forwarded-For is trusted (empty = trust no header). If the backend sits
# behind a proxy, list it here; otherwise every client appears to come from the proxy address.
TRUSTED_PROXIES=
# Development/tests ONLY: skip the network check for QR check-ins. Rejected when APP_ENV=production.
# ATTENDANCE_ALLOW_ANY_NETWORK=true

# Attendance defaults copied into each new session (a teacher may override them per session)
ATTENDANCE_LATE_AFTER_MINUTES=15
ATTENDANCE_LATES_PER_ABSENCE=3
# Analytics alert thresholds (technical proposals, not institutional rules)
ANALYTICS_ABSENCES_THRESHOLD=3
ANALYTICS_TREND_WINDOW=5
ANALYTICS_TREND_DROP_POINTS=20
# Timezone used to date attendance sessions (IANA name)
INSTITUTION_TIMEZONE=America/Mexico_City

# Login throttling (in-memory, per process). Failures per window before a 429.
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
# Per-IP limit is loose on purpose: many students may share one public IP (campus NAT/proxy).
LOGIN_MAX_FAILURES_PER_IP=150
LOGIN_RATE_WINDOW=15m

# Private evidence storage for justification files. NEVER put it under a web root or a directory
# served by nginx; files are only delivered through authorized API calls. Production needs an
# absolute path outside the code tree (back it up like the database).
STORAGE_DIR=./data/evidence
MAX_EVIDENCE_MB=10
# Make at least one evidence file mandatory for a justification request (not confirmed by the institution)
# JUSTIFICATION_EVIDENCE_REQUIRED=false

# Used only by `go run ./cmd/seed demo` (fictitious demo data; refused when APP_ENV=production).
# Defaults to a documented fictitious password when unset.
# DEMO_PASSWORD=demo-passphrase-2026

# Used only by `go run ./cmd/seed` to create the first ADMIN (fictitious)
SEED_ADMIN_NUMBER=10000001
SEED_ADMIN_PASSWORD=change-this-admin-password

# Integration tests (isolated schemas are created and dropped automatically)
# TEST_DATABASE_URL=postgres://edutrak:edutrak_dev_password@localhost:5433/edutrak_test?sslmode=disable
