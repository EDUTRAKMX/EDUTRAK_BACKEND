# Copy to .env and adjust. All values below are FICTITIOUS placeholders.

APP_ENV=development
LOG_LEVEL=info
HTTP_PORT=8080

# Required
DATABASE_URL=postgres://edutrak:edutrak_dev_password@localhost:5432/edutrak?sslmode=disable
# Required, at least 32 bytes. Generate your own, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
QR_TOKEN_TTL=30s

# Comma-separated CIDRs/IPs of the institutional networks allowed to register attendance
ALLOWED_NETWORKS=192.168.0.0/16,10.0.0.0/8
# Reverse proxies whose X-Forwarded-For is trusted (empty = trust no header)
TRUSTED_PROXIES=

# Login throttling (in-memory, per process). Failures per window before a 429.
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
# Per-IP limit is loose on purpose: many students may share one public IP (campus NAT/proxy).
LOGIN_MAX_FAILURES_PER_IP=150
LOGIN_RATE_WINDOW=15m

# Private evidence storage (never served statically)
STORAGE_DIR=./data/evidence
MAX_EVIDENCE_MB=10

# Used only by `go run ./cmd/seed` to create the first ADMIN (fictitious)
SEED_ADMIN_NUMBER=10000001
SEED_ADMIN_PASSWORD=change-this-admin-password

# Integration tests (isolated schemas are created and dropped automatically)
# TEST_DATABASE_URL=postgres://edutrak:edutrak_dev_password@localhost:5433/edutrak_test?sslmode=disable
