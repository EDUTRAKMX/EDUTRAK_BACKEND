# {{ ansible_managed }}
# Equivalente al z-security.cnf de MariaDB (guía, cap. 08).
listen_addresses = '127.0.0.1,{{ p3_ip }}'
port = {{ p3_puerto_bd }}
max_connections = 50

# Contraseñas con SCRAM; TLS obligatorio para conexiones de red (ver pg_hba.conf).
password_encryption = 'scram-sha-256'
ssl = on
ssl_cert_file = 'tls/servidor.crt'
ssl_key_file = 'tls/servidor.key'
ssl_min_protocol_version = 'TLSv1.3'

# El socket local solo para el grupo postgres (administración con: sudo -u postgres psql -p {{ p3_puerto_bd }}).
unix_socket_permissions = 0770

# Evidencias: conexiones, desconexiones y cambios de esquema.
log_connections = on
log_disconnections = on
log_statement = 'ddl'
log_line_prefix = '%m [%p] %q%u@%d %h '
