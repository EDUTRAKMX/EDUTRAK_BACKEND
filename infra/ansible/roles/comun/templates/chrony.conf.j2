# {{ ansible_managed }}
# Amazon Time Sync Service (enlace local del hipervisor). El TOTP exige hora exacta.
server 169.254.169.123 prefer iburst minpoll 4 maxpoll 4

driftfile /var/lib/chrony/drift
makestep 1.0 3
rtcsync
leapsectz right/UTC
keyfile /etc/chrony.keys
ntsdumpdir /var/lib/chrony
logdir /var/log/chrony

# No se ofrece hora a nadie ni se aceptan comandos por red (chronyc usa el socket local).
port 0
cmdport 0
