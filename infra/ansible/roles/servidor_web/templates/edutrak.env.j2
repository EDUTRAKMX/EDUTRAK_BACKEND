# {{ ansible_managed }}
# Mismo JWT_SECRET, TRUSTED_PROXIES y base de datos en todos los Pages: una sesión
# iniciada en un nodo es válida en el otro (equivalente al error 419 del cap. 17-18).
{% for clave, valor in (p3_app_entorno_comun | combine({'DATABASE_URL': p3_app_url_bd})) | dictsort %}
{{ clave }}={{ valor }}
{% endfor %}
